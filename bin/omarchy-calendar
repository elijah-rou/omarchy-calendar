#!/bin/sh
set -eu

script_path=$(readlink -f -- "$0")
script_dir=$(unset CDPATH; cd -- "$(dirname -- "$script_path")" && pwd)
command_name=${1:-}
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command_name" in
    request)
        exec "$script_dir/omarchy-calendar-backend" "$@"
        ;;
    setup)
        exec "$script_dir/omarchy-calendar-setup" "$@"
        ;;
    sync)
        exec "$script_dir/omarchy-calendar-sync" "$@"
        ;;
    ""|-h|--help)
        printf '%s\n' 'Usage: omarchy-calendar <request|setup|sync> [arguments...]'
        ;;
    *)
        printf 'omarchy-calendar: unknown command: %s\n' "$command_name" >&2
        exit 2
        ;;
esac
