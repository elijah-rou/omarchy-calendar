#!/usr/bin/env python3
"""Run the widget-facing secure remote account setup protocol."""

from __future__ import annotations

import importlib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
remote_setup = importlib.import_module("backend.remote_setup")


if __name__ == "__main__":
    raise SystemExit(remote_setup.main())
