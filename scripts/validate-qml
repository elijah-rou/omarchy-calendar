#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

omarchy plugin validate .
node tests/model.test.js
node --check Model.js
node --check tests/model.test.js
qmllint -I /usr/share/omarchy/shell -I /usr/lib/qt6/qml Panel.qml
qmllint Model.js

if rg -q 'QtQuick\.Dialogs|\bFileDialog\s*\{' Panel.qml; then
  printf 'Panel.qml must use an external file picker; native Qt dialogs can crash Quickshell\n' >&2
  exit 1
fi
rg -q '"/usr/bin/zenity"' Panel.qml

# Qt's standalone parser does not understand Quickshell's typed IPC methods.
# Strip only the `: void` return annotation in a same-directory lint copy so
# relative imports still resolve and the rest of the shipped entry point parses.
lint_entry="$root/.BarWidget.lint.qml"
trap 'rm -f "$lint_entry"' EXIT
sed -E 's/(function [A-Za-z0-9_]+\(\)): void/\1/' BarWidget.qml >"$lint_entry"
qmllint -I /usr/share/omarchy/shell -I /usr/lib/qt6/qml "$lint_entry"

printf 'QML validation passed\n'
