#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
python -m compileall -q backend tests
python -m py_compile bin/omarchy-calendar
python -m unittest discover -s tests -p 'test_*.py' -v
./scripts/validate-qml
if command -v ruff >/dev/null 2>&1; then
  ruff check backend tests
  ruff check --stdin-filename bin/omarchy-calendar.py - < bin/omarchy-calendar
fi
if command -v shellcheck >/dev/null 2>&1; then shellcheck scripts/validate scripts/validate-qml; fi
for script in bin/omarchy-calendar scripts/validate scripts/validate-qml; do test -x "$script"; done
python - <<'PY'
import icalendar
print("python-icalendar", icalendar.__version__)
PY
if command -v khal >/dev/null 2>&1; then khal --version; fi
printf 'validation passed\n'
