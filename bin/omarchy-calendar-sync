#!/usr/bin/env python3
"""Run one bounded vdirsyncer pass and record its result."""

from __future__ import annotations

import datetime as dt
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

TIMEOUT_SECONDS = 300
MAX_ERROR_BYTES = 4096


def xdg_path(variable: str, fallback: str) -> Path:
    value = os.environ.get(variable)
    return Path(value).expanduser() if value else Path.home() / fallback


def write_status(path: Path, status: dict[str, object]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".sync-status-", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(status, stream, ensure_ascii=False, separators=(",", ":"))
            stream.write("\n")
        os.replace(temporary, path)
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        Path(temporary).unlink(missing_ok=True)
        raise


def main() -> int:
    os.umask(0o077)
    config = xdg_path("XDG_CONFIG_HOME", ".config") / "omarchy-calendar" / "vdirsyncer.conf"
    status_path = xdg_path("XDG_STATE_HOME", ".local/state") / "omarchy-calendar" / "sync-status.json"
    started = dt.datetime.now(dt.timezone.utc).isoformat()
    executable = shutil.which("vdirsyncer")
    if not config.is_file():
        print(f"sync is not configured: {config}", file=sys.stderr)
        return 0
    if executable is None:
        status = {"attempted": True, "ok": False, "at": started, "error": "vdirsyncer is not installed"}
        write_status(status_path, status)
        print(status["error"], file=sys.stderr)
        return 1
    try:
        with tempfile.TemporaryFile() as error_stream:
            process = subprocess.Popen(
                [executable, "-c", str(config), "sync"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=error_stream,
                start_new_session=True,
            )
            try:
                returncode = process.wait(timeout=TIMEOUT_SECONDS)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(process.pid, signal.SIGTERM)
                    process.wait(timeout=1)
                except (ProcessLookupError, subprocess.TimeoutExpired):
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    process.wait(timeout=1)
                raise
            error_stream.seek(0)
            error = error_stream.read(MAX_ERROR_BYTES).decode("utf-8", errors="replace").strip()
        status = {"attempted": True, "ok": returncode == 0, "at": started}
        if returncode != 0:
            status["error"] = error or f"vdirsyncer exited with status {returncode}"
    except subprocess.TimeoutExpired:
        status = {"attempted": True, "ok": False, "at": started, "error": f"sync timed out after {TIMEOUT_SECONDS} seconds"}
    except OSError as error:
        status = {"attempted": True, "ok": False, "at": started, "error": str(error)[:MAX_ERROR_BYTES]}
    write_status(status_path, status)
    if not status["ok"]:
        print(status["error"], file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
