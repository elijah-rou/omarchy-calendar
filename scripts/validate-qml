#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

omarchy plugin validate .
node tests/model.test.js
node --check Model.js
node --check tests/model.test.js
qmllint -I /usr/share/omarchy/shell -I /usr/lib/qt6/qml Panel.qml
qmllint Model.js

# The v1 UI is subscription-only. Provider account setup, writable event UI,
# and native file dialogs must not creep back into the shipped QML/model.
if rg -qi 'oauth|icloud|caldav|FileDialog|QtQuick\.Dialogs|zenity|validateCreateInput|validateSetupInput|setup-request|action:[[:space:]]*"create"' Panel.qml Model.js BarWidget.qml tests/model.test.js; then
  printf 'legacy provider, writable-event, or native-dialog UI found\n' >&2
  exit 1
fi
rg -q 'Settings → Integrate calendar → Secret address in iCal format' Panel.qml
if rg -qi 'thunderbird|Open Thunderbird|iconText:[[:space:]]*"\+"' Panel.qml Model.js BarWidget.qml; then
  printf 'external calendar launcher found in read-only widget UI\n' >&2
  exit 1
fi

# Qt's standalone parser does not understand Quickshell's typed IPC methods.
lint_entry="$root/.BarWidget.lint.qml"
trap 'rm -f "$lint_entry"' EXIT
sed -E 's/(function [A-Za-z0-9_]+\(\)): void/\1/' BarWidget.qml >"$lint_entry"
qmllint -I /usr/share/omarchy/shell -I /usr/lib/qt6/qml "$lint_entry"

printf 'QML validation passed\n'
