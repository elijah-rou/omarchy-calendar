{
  "schemaVersion": 1,
  "id": "elijahrou.calendar",
  "name": "Omarchy Calendar",
  "version": "1.0.0",
  "author": "Elijah Roussos",
  "description": "Read-only ICS calendar and agenda for the Omarchy bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Calendar",
    "description": "Clock with a read-only ICS month view and upcoming agenda",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "d MMMM 'W'ww yyyy",
      "verticalFormat": "ddd\nMMM\ndd\n—\nHH\nmm",
      "verticalFormatAlt": "dd\nMMM\n'W'ww\n''yy"
    }
  }
}
